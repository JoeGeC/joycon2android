# Copy this file to `keystore.properties` and fill in your release-signing details.
# `keystore.properties` and the keystore itself are gitignored — never commit them.
#
# Generate a keystore with:
#   keytool -genkeypair -v -keystore release.jks -alias joycon2android \
#     -keyalg RSA -keysize 2048 -validity 10000
#
# storeFile is resolved relative to the repository root.

storeFile=release.jks
storePassword=your-store-password
keyAlias=joycon2android
keyPassword=your-key-password
